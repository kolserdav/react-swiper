    "@types/webpack-env": "^1.18.5",
    "css-loader": "^7.1.5",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "next": "16.4.0",
    "prettier": "^3.9.10",
